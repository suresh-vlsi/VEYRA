# Local Docker default. For your laptop Wi-Fi, use http://YOUR-WINDOWS-IP:8000
BASE_URL=http://localhost:8000
# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-secret
# Set true only when served over HTTPS (custom domain / TLS reverse proxy)
COOKIE_SECURE=false
